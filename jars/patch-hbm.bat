@echo off
chcp 65001 >nul
set "HBMDIR=%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$c=[IO.File]::ReadAllText('%~f0'); $c=$c.Substring($c.LastIndexOf('#PS'+'#')+4); & ([scriptblock]::Create($c)) %*"
echo.
pause
exit /b
#PS#
param([Parameter(Mandatory=$true)][string]$Jar)
$ErrorActionPreference = 'Stop'
Add-Type -AssemblyName System.IO.Compression
Add-Type -AssemblyName System.IO.Compression.FileSystem
$dir = $env:HBMDIR.TrimEnd([char]92)
$src = (Resolve-Path $Jar).Path
$out = Join-Path $dir ([IO.Path]::GetFileNameWithoutExtension($src) + '-fix2.jar')
Copy-Item $src $out -Force
$cls = [Convert]::FromBase64String('')
$name = 'com/hbm/mixin/MixinAbstractContainerMenu.class'
$zip = [IO.Compression.ZipFile]::Open($out, 'Update')
try {
    $e = $zip.GetEntry($name)
    if (-not $e) { throw "В jar нет $name" }
    $e.Delete()
    $ne = $zip.CreateEntry($name)
    $w = $ne.Open(); $w.Write($cls, 0, $cls.Length); $w.Close()
    @($zip.Entries | Where-Object { $_.FullName -match '^META-INF/[^/]+\.(SF|RSA|DSA|EC)$' }) | ForEach-Object { $_.Delete() }
} finally { $zip.Dispose() }
Write-Host "Готово: $out"
Write-Host "Положи этот файл в mods/ вместо оригинала."
